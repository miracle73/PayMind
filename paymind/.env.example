# OpenRouter API key for LLM access
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Kite AI testnet (chain ID 2368)
KITE_RPC_URL=https://rpc-testnet.gokite.ai

# Private key of the agent wallet (fund at https://faucet.gokite.ai)
KITE_PRIVATE_KEY=0xyour_private_key_here

# Address that receives the agent's payment
PAYMENT_RECIPIENT_ADDRESS=0xyour_recipient_address_here

# Set to "true" to bypass real chain calls (good for offline demos)
DEMO_MODE=false
